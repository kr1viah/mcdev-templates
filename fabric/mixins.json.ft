{
  "required": true,
  "minVersion": "0.8",
#if (!$CLIENT)
  "package": "${MAIN_CLASS.packageName}.mixin",
#else
  "package": "${MAIN_CLASS.packageName}.client.mixin",
#end
  "compatibilityLevel": "JAVA_${JAVA_VERSION}",
#if (!($SPLIT_SOURCES && $VERSIONS.minecraftVersion.compareTo($mcver.MC1_18) >= 0) || !$CLIENT)
  "mixins": [
  ],
#end
#if (!($SPLIT_SOURCES && $VERSIONS.minecraftVersion.compareTo($mcver.MC1_18) >= 0) || $CLIENT)
  "client": [
  ],
#end
#if ($CLIENT && $MIXIN_PLUGIN_CLIENT)
  "plugin": "${MAIN_CLASS.packageName}.client.MixinPluginClient",
#end
#if (!$CLIENT && $MIXIN_PLUGIN)
  "plugin": "${MAIN_CLASS.packageName}.MixinPlugin",
#end
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
